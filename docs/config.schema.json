{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "description": "The file as written; anything it leaves out is the default.",
  "type": "object",
  "properties": {
    "colors": {
      "$ref": "#/$defs/ColorsSection",
      "default": {
        "ansi": [],
        "scheme": "scull-dark"
      }
    },
    "font": {
      "$ref": "#/$defs/FontSection",
      "default": {
        "family": "",
        "size": 13.0
      }
    },
    "keybind": {
      "description": "Key bindings laid over the defaults.",
      "$ref": "#/$defs/Keybinds",
      "default": []
    },
    "scrollback": {
      "description": "History rows kept per terminal; applies to terminals opened afterwards.",
      "$ref": "#/$defs/Scrollback",
      "default": 10000
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Action": {
      "description": "What a binding does. The numbers are the C ABI's `TT_ACTION_*` values and\nnever change.",
      "oneOf": [
        {
          "description": "Removes a default binding of the same chord; never in [`crate::Settings::bindings`].",
          "type": "string",
          "const": "none"
        },
        {
          "description": "Paste the clipboard.",
          "type": "string",
          "const": "paste"
        },
        {
          "description": "Make the font one point larger.",
          "type": "string",
          "const": "font-larger"
        },
        {
          "description": "Make the font one point smaller.",
          "type": "string",
          "const": "font-smaller"
        },
        {
          "description": "Back to the configured font size.",
          "type": "string",
          "const": "font-reset"
        },
        {
          "description": "Scroll the history one screen up.",
          "type": "string",
          "const": "scroll-page-up"
        },
        {
          "description": "Scroll the history one screen down.",
          "type": "string",
          "const": "scroll-page-down"
        },
        {
          "description": "Scroll to the oldest history row.",
          "type": "string",
          "const": "scroll-to-top"
        },
        {
          "description": "Scroll back to the screen.",
          "type": "string",
          "const": "scroll-to-bottom"
        }
      ]
    },
    "AnsiOverrides": {
      "description": "The first colours of the palette, replacing the scheme's.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rgb"
      },
      "maxItems": 16
    },
    "Chord": {
      "description": "Modifiers (ctrl, alt, shift, super) and one key joined by `+`: a character, f1 to f35, or one of space, escape, enter, tab, backspace, insert, delete, left, right, up, down, page-up, page-down, home, end. A character needs ctrl, alt or super.",
      "type": "string",
      "maxLength": 64
    },
    "ColorsSection": {
      "description": "`[colors]`.",
      "type": "object",
      "properties": {
        "ansi": {
          "description": "Palette entries 0 to 15, from the first; fewer than 16 keeps the rest.",
          "$ref": "#/$defs/AnsiOverrides",
          "default": []
        },
        "background": {
          "description": "Default background colour.",
          "$ref": "#/$defs/Rgb"
        },
        "cursor": {
          "description": "Cursor colour.",
          "$ref": "#/$defs/Rgb"
        },
        "foreground": {
          "description": "Default text colour.",
          "$ref": "#/$defs/Rgb"
        },
        "scheme": {
          "description": "The built-in scheme everything below overrides.",
          "$ref": "#/$defs/Scheme",
          "default": "scull-dark"
        }
      },
      "additionalProperties": false
    },
    "Entry": {
      "description": "One `[[keybind]]` table.",
      "type": "object",
      "properties": {
        "action": {
          "description": "The action; `none` frees a default chord.",
          "$ref": "#/$defs/Action"
        },
        "key": {
          "description": "The chord that triggers the action.",
          "$ref": "#/$defs/Chord"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "action"
      ]
    },
    "Family": {
      "description": "A font family name: empty for the platform's monospace font.",
      "type": "string",
      "maxLength": 128
    },
    "FontSection": {
      "description": "`[font]`.",
      "type": "object",
      "properties": {
        "family": {
          "description": "Family name; empty for the platform's monospace font.",
          "$ref": "#/$defs/Family",
          "default": ""
        },
        "size": {
          "description": "Size in points.",
          "$ref": "#/$defs/FontSize",
          "default": 13.0
        }
      },
      "additionalProperties": false
    },
    "FontSize": {
      "description": "A font size in points.",
      "type": "number",
      "format": "float",
      "maximum": 200.0,
      "minimum": 4.0
    },
    "Keybinds": {
      "description": "The `[[keybind]]` list, checked as a whole.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "maxItems": 256
    },
    "Rgb": {
      "description": "A colour as `0xRRGGBB`.",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "Scheme": {
      "description": "The built-in colour schemes.",
      "oneOf": [
        {
          "description": "Light text on near-black; the xterm palette.",
          "type": "string",
          "const": "scull-dark"
        },
        {
          "description": "Dark text on near-white.",
          "type": "string",
          "const": "scull-light"
        },
        {
          "description": "Ethan Schoonover's Solarized, dark variant.",
          "type": "string",
          "const": "solarized-dark"
        }
      ]
    },
    "Scrollback": {
      "description": "History rows to keep.",
      "type": "integer",
      "format": "uint32",
      "maximum": 1000000,
      "minimum": 0
    }
  }
}
