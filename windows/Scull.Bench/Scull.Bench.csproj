<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renderer throughput on the T3 input (T17.4), the Windows twin of
       macos/Tests/ScullKitTests/RendererBenchmark.swift. Compiles on every
       host; runs only where Direct3D 11 does. `just windows-bench` runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Scull.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Scull.Render/Scull.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scull.Render.Tests" />
  </ItemGroup>

</Project>
