<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Direct3D 11 and DirectWrite renderer, with no WinUI types, so the
       shell (T17.3) and headless tests share it. Windows only at run time,
       but it compiles on every host so a break shows on any runner. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Scull.Render</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exact: the 0.x line may change generated shapes between releases (research.md §6.1). -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="[0.3.358]" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Scull.Core/Scull.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The macOS app's copy and licence (T27), so both platforms ship one file;
         SymbolFont.BundledPath finds it in Fonts next to the assembly. -->
    <Content Include="../../macos/Resources/SymbolsNerdFontMono-Regular.ttf;../../macos/Resources/SymbolsNerdFont-LICENSE"
             Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Scull.Render.Tests" />
  </ItemGroup>

</Project>
